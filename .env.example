# MongoDB Atlas connection string. Leave blank until the database is configured.
MONGO_URI=
MONGO_DATABASE=workflow_builder
LOG_LEVEL=INFO
CORS_ORIGINS=["http://127.0.0.1:8090"]

# JSON list of hosts API workflow nodes may call, e.g. ["api.example.com"].
API_ALLOWED_HOSTS=["www.googleapis.com","gmail.googleapis.com","api.weather.gov","api.open-meteo.com","httpbin.org","hn.algolia.com","www.reddit.com"]

# Production ErrAgent bridge. The frontend is hosted separately at https://www.erragent.com.
ERRAGENT_API_URL=https://erragent.onrender.com/api/v1/circuit/architect
ERRAGENT_API_KEY=

# Optional dedicated MongoDB URI for workflow data access. Prefer a per-user secret for multi-tenant data.
MONGO_WORKFLOW_URI=

# Add this only when LLM nodes are enabled.
GOOGLE_API_KEY=

# Resend API key for the Send Email workflow block. Keep this server-side.
RESEND_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=

# Google Calendar OAuth application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/api/connections/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DEV_USER_ID=local-dev-user

# Clerk frontend authentication. This publishable key is safe to expose to the browser.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk issuer URL for future backend JWT verification.
CLERK_ISSUER=